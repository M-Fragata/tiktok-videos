generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id            String   @id @default(uuid())
  theme         String
  status        String   @default("PENDING")
  videoUrl      String?
  remotionProps Json?
  createdAt     DateTime @default(now())

  @@map("videos")
}

model CustomSfx {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  prompt    String
  filePath  String
  createdAt DateTime @default(now())

  @@map("custom_sfx")
}
