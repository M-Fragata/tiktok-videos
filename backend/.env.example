PORT=3333
PUBLIC_BASE_URL="http://127.0.0.1:3333"
# Banco de dados local SQLite (sem necessidade de Docker)
DATABASE_URL="file:./dev.db"

# Google Gemini (@google/genai)
GEMINI_API_KEY="sua-chave-gemini-aqui"

# ElevenLabs TTS Multi-Voz (/with-timestamps)
# As vozes (narrador, protagonista e catálogo de personagens) são gerenciadas centralizadamente em:
# backend/src/config/voices.json
ELEVENLABS_API_KEY="sua-chave-elevenlabs-aqui"

# Geração de Imagens:
# IMAGE_PROVIDER: 'pollinations' (100% gratuito, sem cartão, ideal para dev) ou 'fal' (produção)
IMAGE_PROVIDER="pollinations"
IMAGE_MODEL="schnell"
FALL_AI_KEY="seu_key_id:seu_key_secret"
