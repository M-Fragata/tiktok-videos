{
  "name": "fragata-shorts-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/server.ts",
    "start": "node --dns-result-order=ipv4first --env-file-if-exists=.env src/server.ts",
    "lint": "oxlint src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.32.0",
    "@prisma/client": "^6.2.1",
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.5",
    "oxlint": "^1.93.0",
    "prisma": "^6.2.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
